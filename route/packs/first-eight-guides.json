  "lessons": [
    {
      "stageId": "route-01-follow",
      "contentHash": "6f306750d513dc7adaa90a99e469a2655249a5241c33f8eb7112794cd31f7dfe",
      "concept": "연결된 탱크를 거쳐 같은 색 도착지로 보낸다.",
      "automatic": true,
      "intro": "탱크를 고른 뒤 화살표로 연결된 곳을 누르세요. 같은 색 도착지에 모든 물을 보내면 끝나요.",
      "completion": "화살표를 따라 도착지까지 보냈어요. 가득 찬 탱크도 직접 보내야 해요.",
      "fallback": "남은 물을 화살표로 연결된 같은 색 도착지까지 보내세요.",
      "cues": [
        {
          "id": "full-red",
          "when": {
            "bottles": {
              "J": [
                0,
                0,
                0,
                0
              ]
            }
          },
          "text": "J가 빨강 4칸으로 찼어요. 자동으로 사라지지 않아요. J → 빨강 도착지로 보내세요."
        },
        {
          "id": "full-blue",
          "when": {
            "bottles": {
              "K": [
                1,
                1,
                1,
                1
              ]
            }
          },
          "text": "K에 파랑 4칸이 모였어요. K → 파랑 도착지로 보내세요."
        },
        {
          "id": "follow-red",
          "when": {
            "bottles": {
              "A": [
                0,
                0
              ]
            }
          },
          "text": "A를 고르면 J로 향하는 길이 강조돼요. A에서 빨강 도착지로 바로 건너뛸 수는 없어요."
        },
        {
          "id": "follow-blue",
          "when": {
            "bottles": {
              "B": [
                1,
                1
              ]
            }
          },
          "text": "B에 남은 파랑을 K로 옮긴 뒤 파랑 도착지로 보내세요."
        },
        {
          "id": "remaining-red",
          "when": {
            "top": {
              "J": 0
            }
          },
          "text": "J에 남은 빨강을 빨강 도착지로 보내세요."
        },
        {
          "id": "remaining-blue",
          "when": {
            "top": {
              "K": 1
            }
          },
          "text": "K에 남은 파랑을 파랑 도착지로 보내세요."
        }
      ]
    },
    {
      "stageId": "route-02-uncover",
      "contentHash": "017740ffd98d67d5d2419bfda48a897c40e9086701306d209522ec2b18deb6fc",
      "concept": "윗물을 따로 모아 아래에 가려진 색을 드러낸다.",
      "automatic": true,
      "intro": "탱크에서는 맨 위의 같은 색만 함께 움직여요. 빈 탱크나 맨 위가 같은 색인 탱크가 받을 수 있어요.",
      "completion": "윗물을 옮겨 아래 색을 드러냈어요. 모은 물은 도착지에 직접 보내세요.",
      "fallback": "남은 맨 위 물과 화살표를 살펴보세요. 같은 색을 모은 뒤 도착지에 보낼 수 있어요.",
      "cues": [
        {
          "id": "wrong-blue",
          "when": {
            "top": {
              "J": 1
            }
          },
          "text": "J에서는 빨강 도착지로만 보낼 수 있어요. J에 파랑을 보낸 이동을 되돌리고 파랑을 K로 보내 보세요."
        },
        {
          "id": "wrong-red",
          "when": {
            "top": {
              "K": 0
            }
          },
          "text": "K에서는 파랑 도착지로만 보낼 수 있어요. K에 빨강을 보낸 이동을 되돌리고 빨강을 J로 보내 보세요."
        },
        {
          "id": "red-exposed",
          "when": {
            "bottles": {
              "A": [
                0,
                0
              ]
            }
          },
          "text": "A 아래의 빨강이 드러났어요. J가 비어 있거나 빨강이면 A → J로 보낼 수 있어요."
        },
        {
          "id": "blue-exposed",
          "when": {
            "bottles": {
              "B": [
                1,
                1
              ]
            }
          },
          "text": "B 아래의 파랑이 드러났어요. K가 비어 있거나 파랑이면 B → K로 보낼 수 있어요."
        },
        {
          "id": "two-tops",
          "when": {
            "bottles": {
              "A": [
                0,
                0,
                1,
                1
              ],
              "B": [
                1,
                1,
                0,
                0
              ]
            }
          },
          "text": "A 위의 파랑 2칸은 K로, B 위의 빨강 2칸은 J로 옮길 수 있어요. 어느 쪽부터 해도 좋아요."
        },
        {
          "id": "deliver-red",
          "when": {
            "top": {
              "J": 0
            }
          },
          "text": "J에 모인 빨강을 빨강 도착지로 보내세요."
        },
        {
          "id": "deliver-blue",
          "when": {
            "top": {
              "K": 1
            }
          },
          "text": "K에 모인 파랑을 파랑 도착지로 보내세요."
        }
      ]
    },
    {
      "stageId": "route-03-hold",
      "contentHash": "404224719ae7c693310c1fc7e8cb0bf3481fb1a018b00df487b66c737d7b6ca3",
      "concept": "파랑을 K에 남겨 빨강의 길을 연 채로 유지한다.",
      "automatic": true,
      "intro": "K에 파랑만 2칸 이상 있으면 × 수문이 열려요. 이번에는 A → J 길을 열어 주세요.",
      "completion": "빨강이 수문을 지나면 파랑도 보내도 돼요. 목표를 전부 채우면 수문이 닫혀도 클리어예요.",
      "fallback": "빨강이 A에서 J로 지나갈 때까지 K의 파랑을 남겨 두세요.",
      "cues": [
        {
          "id": "undo-blue",
          "when": {
            "bottles": {
              "A": [
                0,
                0,
                0,
                0
              ]
            },
            "delivered": {
              "B-out": 2
            }
          },
          "text": "파랑을 모두 보내 A → J 길이 닫혔어요. 되돌리기로 파랑을 돌려놓아 보세요."
        },
        {
          "id": "red-crossed",
          "when": {
            "bottles": {
              "A": []
            }
          },
          "text": "빨강이 수문을 통과했어요. 남아 있는 물을 같은 색 도착지로 보내세요. 이제 순서는 자유예요."
        },
        {
          "id": "hold-open",
          "when": {
            "gateOpen": true
          },
          "text": "수문이 열렸어요. K의 파랑을 보내기 전에 A → J로 빨강을 통과시키세요."
        },
        {
          "id": "fill-control",
          "when": {
            "bottles": {
              "B": [
                1,
                1
              ],
              "K": []
            }
          },
          "text": "B → K로 파랑 2칸을 옮기면 수문이 열려요."
        }
      ]
    },
    {
      "stageId": "route-04-reserve",
      "contentHash": "08d5c1e0482d41f8ce20273154f4733e6ab582c73464df5873416b3ef5754189",
      "concept": "파랑을 보내기 전에 다시 수문을 열 예비 파랑부터 드러낸다.",
      "automatic": false,
      "intro": "문이 닫혀도 다시 열 수 있을까요? A 아래의 파랑을 어떻게 꺼낼지 살펴보세요.",
      "completion": "다시 쓸 파랑을 먼저 드러내면 문을 닫았다 열 수도 있어요. 처음부터 끝까지 열어 두는 길도 있어요.",
      "fallback": "파랑을 보내기 전 A 위의 빨강부터 J로 옮기면 예비 파랑을 꺼낼 수 있어요.",
      "cues": [
        {
          "id": "no-reserve",
          "when": {
            "bottles": {
              "A": [
                1,
                1,
                0,
                0
              ]
            },
            "delivered": {
              "B-out": 2
            }
          },
          "text": "예비 파랑이 A의 빨강 아래에 갇혀 있어요. K의 파랑을 보낸 이동을 되돌리고 A 위를 먼저 비워 보세요."
        },
        {
          "id": "refill",
          "when": {
            "bottles": {
              "A": [
                1,
                1
              ],
              "K": []
            },
            "gateOpen": false
          },
          "text": "A에 파랑 2칸이 드러나 있어요. A → K로 보내 닫힌 문을 다시 열 수 있어요."
        }
      ]
    },
    {
      "stageId": "route-05-release",
      "contentHash": "acb989691d56d24b410fae3a6664ec62aa9861e8dd421069547153087c0360de",
      "concept": "수문을 쓴 뒤 파랑을 보내 K를 다른 색의 통로로 바꾼다.",
      "automatic": false,
      "intro": "A의 빨강은 K를 지나야 해요. 파랑을 계속 남겨 두기만 해도 될까요?",
      "completion": "B가 수문을 지난 뒤 파랑을 보냈어요. 빈 K는 A의 빨강이 지나가는 통로가 됐어요.",
      "fallback": "B → J로 먼저 수문을 쓰세요. 그 뒤 K의 파랑을 보내고 A의 빨강을 K로 옮길 수 있어요.",
      "cues": [
        {
          "id": "release-now",
          "when": {
            "bottles": {
              "B": [],
              "K": [
                1,
                1,
                1,
                1
              ]
            }
          },
          "text": "B가 수문을 지났어요. 이제 파랑을 도착지로 보내 K를 비워도 돼요. A의 빨강이 그 자리를 쓸 수 있어요."
        },
        {
          "id": "released-too-soon",
          "when": {
            "bottles": {
              "B": [
                0,
                0
              ]
            },
            "delivered": {
              "B-out": 4
            }
          },
          "text": "B의 빨강이 아직 수문 앞에 있어요. 파랑을 보낸 이동을 되돌린 뒤 B부터 통과시켜 보세요."
        }
      ]
    },
    {
      "stageId": "route-06-shared",
      "contentHash": "e12e77cb6e3a3ae221848cd3117075a8426d7035917b42fb2530d4922df76a6d",
      "concept": "공용 탱크를 쓸 색의 순서에 따라 한 번에 모을지 나눠 보낼지 결정한다.",
      "automatic": false,
      "intro": "J는 빨강과 초록이 함께 쓰는 탱크예요. 어느 색을 먼저 모으면 덜 나눠 보낼 수 있을까요?",
      "completion": "먼저 통과시킬 색에 따라 J를 비우는 시점과 부분 전송이 달라져요. 이동 수가 같아야만 정답인 것은 아니에요.",
      "fallback": "처음 C의 빨강 아래에는 초록이 있어요. 빨강을 먼저 J에 모으면 초록 4칸도 한꺼번에 모을 수 있어요.",
      "cues": [
        {
          "id": "green-blocks-red",
          "when": {
            "bottles": {
              "J": [
                3,
                3
              ]
            },
            "top": {
              "C": 0
            }
          },
          "text": "J의 초록이 C의 빨강을 막고 있어요. 초록을 먼저 일부 보내 J를 비우면 계속할 수 있어요. 다른 순서도 되돌려 비교해 보세요."
        }
      ]
    },
    {
      "stageId": "route-07-split",
      "contentHash": "b2a7033ce1e58cb7d1cb820494d552cf1001a7bbc153e64a17f3cd8b8a591d17",
      "concept": "분할 목표를 보낼 때 수문에 필요한 파랑 2칸을 함께 계산한다.",
      "automatic": false,
      "intro": "파랑 도착지가 1칸과 3칸으로 나뉘었어요. 보내고 남는 파랑으로 수문을 다시 열 수 있을까요?",
      "completion": "같은 수문 닫힘이라도 남은 파랑의 양과 위치에 따라 복구 가능성이 달라져요.",
      "fallback": "처음 K에서 1칸을 보내면 A나 B의 파랑으로 보충할 수 있어요. 3칸을 먼저 소모하면 판 전체에 파랑이 1칸만 남아요.",
      "cues": [
        {
          "id": "three-spent",
          "when": {
            "delivered": {
              "B-three": 3,
              "B-one": 0
            }
          },
          "text": "파랑이 1칸만 남았어요. 1칸 도착지로 가는 수문을 다시 열 수 없으니 3칸 전송을 되돌려 보세요."
        }
      ]
    },
    {
      "stageId": "route-08-return",
      "contentHash": "ea764f153094fe8a07303c2c0db711bcefd4b6978ec76d7dd3e3ec4c78852a73",
      "concept": "파랑을 보관해 K를 빌려 쓴 뒤 되가져오는 시점을 선택한다.",
      "automatic": false,
      "intro": "파랑을 없애지 않고 K를 비워야 해요. 빈 P와 돌아오는 화살표가 어디에 쓰일지 생각해 보세요.",
      "completion": "K를 비울 때 파랑을 보관했고, 다시 가져와 초록 길을 열었어요. 빨강을 전부 모으는 길과 나눠 보내는 길을 비교할 수 있어요.",
      "fallback": "K → P로 파랑을 맡겨 두고 K로 빨강을 보내세요. K가 비면 P → K로 파랑을 돌려 초록 길을 열 수 있어요.",
      "cues": [
        {
          "id": "return-for-green",
          "when": {
            "bottles": {
              "K": [],
              "P": [
                1,
                1,
                1,
                1
              ]
            },
            "delivered": {
              "R": 4
            }
          },
          "text": "빨강을 모두 보냈고 K가 비어 있어요. P → K로 파랑을 돌리면 수문이 다시 열려요. 남은 물을 각 도착지로 보내세요."
        },
        {
          "id": "partial-return",
          "when": {
            "bottles": {
              "K": [],
              "P": [
                1,
                1,
                1,
                1
              ]
            },
            "delivered": {
              "R": 2
            }
          },
          "text": "K가 비어 있어요. 남은 빨강을 먼저 보내거나 파랑을 돌려 초록부터 통과시킬 수 있어요."
        },
        {
          "id": "parked-empty",
          "when": {
            "bottles": {
              "K": [],
              "P": [
                1,
                1,
                1,
                1
              ]
            },
            "delivered": {
              "R": 0
            }
          },
          "text": "파랑은 P에 보관돼 있고 K가 비었어요. A나 B의 빨강을 K로 옮겨 보세요."
        },
        {
          "id": "borrowed",
          "when": {
            "bottles": {
              "P": [
                1,
                1,
                1,
                1
              ]
            }
          },
          "text": "파랑은 P에 보관돼 있어요. K의 빨강을 도착지로 보내 비운 뒤 파랑을 다시 가져올 수 있어요."
        }
