rules_version = '2';
// Cloud save for the GitHub Pages build: each signed-in player reads and writes only their own device documents
// at users/{uid}/devices/{device}. Paste into Firebase console > Firestore > Rules and publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function policyPath(uid) { return /databases/$(database)/documents/users/$(uid)/rewardPolicy/daily-best-v2; }
    function validDate(date) { return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && date >= '2026-10-14'; }
    match /users/{uid}/rewardPolicy/{policy} {
      allow read: if owns(uid);
      allow create: if owns(uid) && policy == 'daily-best-v2'
        && request.resource.data.keys().hasOnly(['policy', 'activation', 'clientVersion'])
        && request.resource.data.policy == policy && request.resource.data.clientVersion == 2
        && validDate(request.resource.data.activation);
      // Activation is immutable. Deleting it would let an old client resume additive daily rewards.
      allow update, delete: if false;
    }
    match /users/{uid}/dailyRewardV2/{date} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && exists(policyPath(uid)) && validDate(date)
        && request.resource.data.keys().hasOnly(['policy', 'activation', 'bestStars'])
        && request.resource.data.policy == 'daily-best-v2'
        && request.resource.data.activation == get(policyPath(uid)).data.activation
        && request.resource.data.bestStars is int && request.resource.data.bestStars >= 0
        && (!exists(/databases/$(database)/documents/users/$(uid)/dailyRewardV2/$(date))
          || request.resource.data.bestStars >= resource.data.bestStars);
      allow delete: if false;
    }
    match /users/{uid}/devices/{device} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.device == device
        && ((request.resource.data.v == 1 && !exists(policyPath(uid))
          && request.resource.data.keys().hasOnly(['v', 'device', 'starsMine', 'owned', 'best', 'daily', 'starsDaily', 'unlock', 'savedAt']))
        || (request.resource.data.v == 2 && exists(policyPath(uid))
          && request.resource.data.rewardPolicy == 'daily-best-v2'
          && request.resource.data.rewardActivation == get(policyPath(uid)).data.activation
          && request.resource.data.keys().hasOnly(['v', 'device', 'starsMine', 'owned', 'best', 'daily', 'starsDaily', 'unlock', 'savedAt', 'rewardPolicy', 'rewardActivation'])));
    }
  }
}
